{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "UI: pnpm dev (Run)",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm dev",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "UI: Launch Chrome against dev server",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/src",
            "preLaunchTask": "ui: dev"
        }
    ]
}
